@@ -0,0 +1,28 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { syncMatchesToGoogleCalendar } from "../src/google-calendar.js";
+
+test("Calendar authentication supports ADC without a user token and rejects bad configuration", async () => {
+  const previous = process.env.GOOGLE_CALENDAR_AUTH_MODE;
+  const options = {
+    calendarId: "soccer@example.com",
+    timezone: "America/Sao_Paulo",
+    tokenPath: "/nonexistent-calendar-test/token.json"
+  };
+  try {
+    process.env.GOOGLE_CALENDAR_AUTH_MODE = "service_account";
+    assert.deepEqual(await syncMatchesToGoogleCalendar([], options), {
+      created: 0, updated: 0, links: []
+    });
+    for (const calendarId of ["", "primary", " PRIMARY "]) {
+      await assert.rejects(syncMatchesToGoogleCalendar([], { ...options, calendarId }), /explicit shared/);
+    }
+    process.env.GOOGLE_CALENDAR_AUTH_MODE = "invalid";
+    await assert.rejects(syncMatchesToGoogleCalendar([], options), /Unsupported/);
+    delete process.env.GOOGLE_CALENDAR_AUTH_MODE;
+    await assert.rejects(syncMatchesToGoogleCalendar([], options), /not authorized/);
+  } finally {
+    if (previous === undefined) delete process.env.GOOGLE_CALENDAR_AUTH_MODE;
+    else process.env.GOOGLE_CALENDAR_AUTH_MODE = previous;
+  }
+});
